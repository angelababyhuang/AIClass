  "cards": [
    {
      "dot": "emerald",
      "title": "主生命周期",
      "items": [
        "五个有序阶段：采集 → 分析 → 审核 → （修订） → 入库",
        "saved 是正常终点，只有过门控的数据才进主库",
        "主轨由一条水平 rail 承载，读图一目了然"
      ]
    },
    {
      "dot": "amber",
      "title": "可恢复循环",
      "items": [
        "审核未通过进入修订，改完回到审核而非重跑全流程",
        "iteration 计数上限来自 Planner 策略（1-3 次）",
        "循环只影响 analyses，不回退已采集的 sources"
      ]
    },
    {
      "dot": "rose",
      "title": "等待与降级",
      "items": [
        "待人工是非终态：pending_review 等人做采纳或丢弃决定",
